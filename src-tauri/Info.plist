<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged into the macOS bundle by the Tauri CLI. Without a usage string, macOS privacy (TCC)
       kills or blocks the app when the page calls getUserMedia / navigator.geolocation.
       Microphone is declared ahead of chat calls so they need no new desktop release. -->
  <key>NSCameraUsageDescription</key>
  <string>AMS uses the camera to take attendance photos.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>AMS uses the microphone for chat calls.</string>
  <key>NSLocationUsageDescription</key>
  <string>AMS uses your location for attendance check-in.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>AMS uses your location for attendance check-in.</string>
</dict>
</plist>
