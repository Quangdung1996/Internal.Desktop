{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AMS",
  "version": "0.3.0",
  "identifier": "vn.com.agari.ams",
  "build": {
    "frontendDist": "https://approve.agari.com.vn",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AMS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/64x64.png",
      "tooltip": "AMS",
      "showMenuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NUQ5MkYzQkRBMzVFMjcKUldRblhxTzk4NUpkdHFvb2x3djBJY3pTUS9PWjJWTE1EU01maDZOSmF5N0ZGcmdvVTNQYks2OUYK",
      "endpoints": [
        "https://github.com/Quangdung1996/Internal.Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
